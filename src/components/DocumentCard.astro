---
import type { PortalDocument } from '../lib/registry.ts';

interface Props {
  doc: PortalDocument;
}

const { doc } = Astro.props;
const { parsed } = doc;

/** Enough sections to show the document's shape without turning the card into a list. */
const VISIBLE_SECTIONS = 5;
const shown = parsed.outline.slice(0, VISIBLE_SECTIONS);
const remaining = parsed.outline.length - shown.length;
---

{/*
  Only the heading is a link, stretched over the card by a pseudo-element in
  `portal.css`. Wrapping the whole card in an <a> instead would give it an
  accessible name around sixty words long — unusable in a screen reader's list
  of links — and labelling that anchor to shorten it fails 2.5.3 Label in Name,
  because the visible text would no longer appear in the accessible name. This
  way the name is exactly the visible heading, and the whole card stays
  clickable.
*/}
<div class="card">
  <div class="card-top">
    <span class="audience">{doc.audience}</span>
    <span class="chips">
      {doc.note && <span class="note">{doc.note}</span>}
      <span class="status" data-status={doc.status}>{doc.status}</span>
    </span>
  </div>

  <h2 class="question">
    <a class="card-link" href={`/docs/${doc.slug}`}>{doc.question}</a>
  </h2>
  <p class="doc-title">{parsed.title}</p>
  <p class="summary">{doc.summary}</p>

  {
    shown.length > 0 && (
      <ul class="contents">
        {shown.map((section) => (
          <li>
            <span>{section.text}</span>
            {section.subsections > 0 && (
              <span class="depth">
                {section.subsections}
                {/* Alone, this numeral is announced as a bare "4". */}
                <span class="sr-only"> subsections</span>
              </span>
            )}
          </li>
        ))}
        {remaining > 0 && (
          <li class="more">
            <span>
              {remaining} more {remaining === 1 ? 'section' : 'sections'}
            </span>
          </li>
        )}
      </ul>
    )
  }

  <p class="scale">
    About {parsed.readingMinutes} minutes to read
    {
      parsed.updated && (
        <>
          <span class="sep" aria-hidden="true"> </span>
          <span class="updated">
            Updated <time datetime={parsed.updated.iso}>{parsed.updated.label}</time>
          </span>
        </>
      )
    }
  </p>
</div>

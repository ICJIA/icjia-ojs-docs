---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { portalDocuments, type PortalDocument } from '../lib/registry.ts';

/**
 * Two shelves, split on the audience string rather than on a list of slugs, so
 * a document added later lands on the right one without touching this page.
 * A group with nothing on it is not rendered.
 */
const forDevelopers = (doc: PortalDocument) => /developer/i.test(doc.audience);
const minutes = (docs: PortalDocument[]) => docs.reduce((n, d) => n + d.parsed.readingMinutes, 0);
const groups = [
  {
    id: 'managers',
    tone: 'coral',
    title: 'For managers and staff',
    lede: 'Plain language throughout, no technical background assumed, and nothing here asks for a server login. New to the Hub itself? Start with the beginner\u2019s guide.',
    fact: 'Browser only',
    docs: portalDocuments.filter((d) => !forDevelopers(d)),
  },
  {
    id: 'developers',
    tone: 'green',
    title: 'For developers',
    lede: 'Ubuntu, nginx, PHP and MySQL, and a shell. Every command was run on the test box, and every error it hit is written down.',
    fact: 'Linux only',
    docs: portalDocuments.filter(forDevelopers),
  },
].filter((g) => g.docs.length > 0);
---

<BaseLayout
  title="Open Journal Systems at ICJIA — documentation"
  description="Working documents for the ICJIA test server running Open Journal Systems and Open Preprint Systems: what each is, how to run them, how the server was built, and how the two differ."
>
  <main class="page" id="main" tabindex="-1">
    <div class="masthead">
      <h1>Open Journal Systems, on trial at ICJIA</h1>
      <p class="lede">
        A test server is running, with <strong>two separate installations</strong> on it: Open
        Journal Systems for a journal, and Open Preprint Systems for a preprint server beside it.
        One document covers what OJS and OPS are and whether OPS is worth having, one explains
        what the Research Hub is and whether either system could replace it, one covers running
        OJS day to day, one covers running OPS, one asks whether to adopt them and what that would
        mean for the Research Hub, and one covers how the machine was built.
      </p>
    </div>

    {
      groups.map((g) => (
        <section class="group" data-tone={g.tone} aria-labelledby={`group-${g.id}`}>
          <div class="group-head">
            <div class="group-count" aria-hidden="true">{g.docs.length}</div>
            <div class="group-text">
              <h2 id={`group-${g.id}`}>{g.title}</h2>
              <p class="group-lede">{g.lede}</p>
            </div>
            <ul class="group-facts" aria-label={`${g.title}, at a glance`}>
              <li><b>{g.docs.length}</b>{g.docs.length === 1 ? 'document' : 'documents'}</li>
              <li><b>{minutes(g.docs)}</b>minutes in all</li>
              <li><b>{g.fact.split(' ')[0]}</b>{g.fact.split(' ').slice(1).join(' ')}</li>
            </ul>
          </div>
          <div class="shelf">
            {g.docs.map((doc) => <DocumentCard doc={doc} />)}
          </div>
        </section>
      ))
    }

    <footer class="colophon">
      <p>
        These documents are drafts, and the server they describe is temporary. Nothing published on
        it is permanent.
      </p>
      <p>
        They are written from a close reading of the official Open Journal Systems and Open Preprint
        Systems documentation, and from a working test installation — not from experience of running
        either system in production. <strong>Expect some of this to be wrong, and some of it to go out
        of date.</strong> That is the nature of a document written while the thing it describes is
        still being decided. If you find something incorrect, unclear, or no longer true, say so —
        every page carries a link for it, and corrections are wanted rather than tolerated.
      </p>
      <p>
        This site sets no cookies and runs no analytics. Every page is checked against WCAG 2.1 AA
        before it is published, and every figure quoted about the Research Hub names its source.
      </p>
    </footer>
  </main>
</BaseLayout>

---
import TableOfContents from '../components/TableOfContents.astro';
import type { PortalDocument } from '../lib/registry.ts';
// Imported raw so it can be emitted immediately after the document's own CSS.
// Astro's bundled stylesheets carry no ordering guarantee relative to an inline
// <style>, and the chrome must win the cascade against the document's global
// element rules.
import shellCss from '../styles/document-shell.css?raw';

interface Props {
  doc: PortalDocument;
}

const { doc } = Astro.props;
const { parsed } = doc;
const hasContents = parsed.headings.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{parsed.title}</title>
    <meta name="description" content={doc.summary} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* The document's own font links, carried over so its typography survives. */}
    <Fragment set:html={parsed.headLinks} />

    {parsed.css && <style is:inline set:html={parsed.css} />}
    <style is:inline set:html={shellCss} />
  </head>

  <body>
    <a class="px-skip" href="#px-document">Skip to document</a>
    <header class="px-bar">
      <a class="px-back" href="/">All documents</a>
      <span class="px-here">{parsed.title}</span>
      {
        hasContents && (
          <button
            class="px-toggle"
            id="px-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="px-panel"
          >
            Contents
          </button>
        )
      }
      <div class="px-progress" id="px-progress"></div>
    </header>

    <TableOfContents headings={parsed.headings} />

    <div class="px-doc" id="px-document" tabindex="-1">
      <Fragment set:html={parsed.bodyHtml} />
    </div>

    {/* The document's own behaviour — the runbook's copy-to-clipboard buttons. */}
    {parsed.scripts && <script is:inline set:html={parsed.scripts} />}

    <script>
      const panel = document.getElementById('px-panel');
      const toggle = document.getElementById('px-toggle');
      const progress = document.getElementById('px-progress');

      const HEADER_CLEARANCE = 84;
      const DURATION = 460;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

      let frame = 0;
      const stop = () => {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
      };

      /** Scroll `target` to just below the header, then give it keyboard focus. */
      const goTo = (target: HTMLElement) => {
        stop();
        const root = document.documentElement;
        const max = root.scrollHeight - window.innerHeight;
        const to = Math.max(0, Math.min(max, target.getBoundingClientRect().top + window.scrollY - HEADER_CLEARANCE));
        const from = window.scrollY;

        const land = () => {
          // Recompute rather than trust the figure from click time. A long
          // document can shift under the animation — a late webfont, an image,
          // a frame the browser skipped — and being 250px short puts the
          // heading back under the header, which is the whole bug. Correcting
          // at the end costs nothing and makes the landing exact regardless.
          const settled = Math.max(
            0,
            Math.min(
              root.scrollHeight - window.innerHeight,
              target.getBoundingClientRect().top + window.scrollY - HEADER_CLEARANCE,
            ),
          );
          if (Math.abs(settled - window.scrollY) > 1) {
            window.scrollTo({ top: settled, behavior: 'instant' });
          }
          // Headings are not focusable, so reading does not otherwise continue
          // from here for anyone using a keyboard or a screen reader.
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        };

        if (reduceMotion.matches || Math.abs(to - from) < 2) {
          window.scrollTo({ top: to, behavior: 'instant' });
          land();
          return;
        }

        const started = performance.now();
        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const step = (now: number) => {
          const p = Math.min(1, (now - started) / DURATION);
          // `instant` matters: the documents set scroll-behavior: smooth, which
          // would otherwise animate every single frame of this animation.
          window.scrollTo({ top: from + (to - from) * ease(p), behavior: 'instant' });
          if (p < 1) frame = requestAnimationFrame(step);
          else { frame = 0; land(); }
        };
        frame = requestAnimationFrame(step);
      };

      // If the reader takes over, stop immediately rather than fighting them.
      for (const evt of ['wheel', 'touchstart', 'pointerdown'] as const) {
        window.addEventListener(evt, stop, { passive: true });
      }
      window.addEventListener('keydown', (e) => {
        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key)) stop();
      });

      // Back and forward still work, because the click pushed a history entry.
      window.addEventListener('popstate', () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const target = id && document.getElementById(id);
        if (target) goTo(target);
      });

      const setOpen = (open: boolean) => {
        if (!panel || !toggle) return;
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
      };

      if (panel && toggle) {
        // `hidden` is typed string | boolean, since it also accepts "until-found".
        toggle.addEventListener('click', () => setOpen(panel.hidden !== false));

        // Choosing a section closes the panel so it does not cover the target,
        // and the scroll is driven here rather than left to the browser.
        //
        // Native fragment navigation under `scroll-behavior: smooth` animates
        // for about four seconds across a long document, and shows nothing at
        // all for the first second. A reader who nudges the wheel in that time
        // cancels the animation wherever it happens to be — which lands the
        // heading behind the sticky header as often as not. A bounded animation
        // starts immediately, always takes the same time, and always ends with
        // the heading clear of the header.
        panel.addEventListener('click', (event) => {
          const link = (event.target as Element).closest('a');
          if (!link) return;
          const id = decodeURIComponent((link as HTMLAnchorElement).hash.slice(1));
          const target = document.getElementById(id);
          if (!target) return;
          event.preventDefault();
          setOpen(false);
          goTo(target);
          history.pushState(null, '', `#${id}`);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !panel.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        document.addEventListener('click', (event) => {
          const target = event.target as Node;
          if (!panel.hidden && !panel.contains(target) && !toggle.contains(target)) {
            setOpen(false);
          }
        });
      }

      const links = panel ? Array.from(panel.querySelectorAll('a')) : [];
      const targets = links.map((link) => document.getElementById(link.hash.slice(1)));

      let queued = false;

      const update = () => {
        queued = false;
        const root = document.documentElement;

        if (progress) {
          const scrollable = root.scrollHeight - root.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, root.scrollTop / scrollable) : 0;
          progress.style.transform = `scaleX(${ratio})`;
        }

        // The current section is the last heading whose top has passed the
        // header. Headings are in document order, so stop at the first miss.
        let active = -1;
        for (let i = 0; i < targets.length; i += 1) {
          const target = targets[i];
          if (target && target.getBoundingClientRect().top <= 100) active = i;
          else break;
        }

        links.forEach((link, i) => {
          if (i === active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    </script>
  </body>
</html>
